# Dung cho docker-compose.yml (bien duoc thay the vao ca 2 service db + app).
# Copy thanh ".env" o cung thu muc nay roi doi cac gia tri mac dinh truoc khi chay that.

# Cong truy cap tren MAY THAT (host) — doi neu 7788 dang bi chiem
APP_PORT=7788

# MySQL — user/password nay dung chung cho ca DB server lan app ket noi vao
MYSQL_ROOT_PASSWORD=doi-mat-khau-root-nay
MYSQL_DATABASE=printer3d
MYSQL_USER=printer3d
MYSQL_PASSWORD=doi-mat-khau-nay

# Bat buoc — chuoi ngau nhien >= 32 ky tu, dung ky session + ma hoa file session luu dia
SESSION_SECRET=doi-chuoi-nay-thanh-random-32-byte-truoc-khi-chay-that

# Chi doi thanh true khi da co nginx/reverse proxy voi HTTPS THAT SU phia truoc.
# De false khi con chay HTTP thuong (vd truy cap qua http://<ip-vps>:PORT chua co domain/TLS).
COOKIE_SECURE=false

# Tuy chon — dat san mat khau admin luc seed lan dau thay vi de tu sinh ngau nhien
ADMIN_PASSWORD=

# Tong dung luong toi da thu muc font (MB)
FONTS_MAX_TOTAL_MB=200
